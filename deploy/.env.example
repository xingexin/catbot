COMPOSE_PROJECT_NAME=catbot
# Existing installations retain COMPOSE_PROJECT_NAME=secretary to reuse data volumes.
POSTGRES_PASSWORD=replace-with-random-hex
MASTER_KEY=replace-with-base64-32-byte-key
RUNTIME_TOKEN=replace-with-random-token
ADMIN_PASSWORD=replace-with-admin-password
WEB_PORT=5173
COOKIE_SECURE=false
QQ_APP_ID=
QQ_SECRET=
QQ_USER_OPENID=
QQ_CONFIG_ID=
QQ_PERSONA_ID=secretary
QQ_BASE_URL=https://api.bot.qq.com
ONEBOT_TOKEN=replace-with-random-token
NAPCAT_ENABLED=true
# Optional: reuse a QQ account already logged in within the persistent volume.
NAPCAT_ACCOUNT=
# Empty uses local NapCat when enabled; set the API URL for an external OneBot service.
ONEBOT_URL=
NAPCAT_WEBUI_TOKEN=replace-with-random-token
NAPCAT_WEB_PORT=6099
CODEBUDDY_INTERNET_ENVIRONMENT=
MAX_UPLOAD_MB=100
