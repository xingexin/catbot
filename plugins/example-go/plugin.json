{
  "id": "example-go",
  "name": "Go 示例工具",
  "version": "1.0.0",
  "entry": "dist/plugin",
  "description": "Go 独立进程插件：文本回显与使用宿主 KV 的命名便签。",
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "tools": [
    {
      "name": "echo",
      "description": "回显文本并统计字符数，用于验证工具链。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "characters": {
            "type": "integer"
          }
        },
        "required": [
          "text",
          "characters"
        ]
      },
      "permissions": [],
      "timeoutSec": 10,
      "retrySafe": true
    },
    {
      "name": "note",
      "description": "读取命名便签；提供 text 时保存便签。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "permissions": [
        "storage"
      ],
      "timeoutSec": 15,
      "retrySafe": true
    }
  ],
  "templates": [],
  "runtime": "binary"
}
